{
  "name": "coastwatch-signature-prototypes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Isolated design prototypes for CoastWatch. Not part of the production app.",
  "scripts": {
    "snapshot": "bash scripts/snapshot-data.sh",
    "dev": "vite --port 3460 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3461 --strictPort",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "maplibre-gl": "6.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
