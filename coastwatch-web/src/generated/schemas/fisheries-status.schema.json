{
  "$defs": {
    "FisheryStatus": {
      "additionalProperties": false,
      "properties": {
        "applies_to_places": {
          "items": {
            "type": "string"
          },
          "title": "Applies To Places",
          "type": "array"
        },
        "area_label": {
          "title": "Area Label",
          "type": "string"
        },
        "cause": {
          "enum": [
            "whale_entanglement",
            "domoic_acid",
            "psp",
            "regulation",
            "season",
            "quality",
            "other"
          ],
          "title": "Cause",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "effective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective"
        },
        "fishery": {
          "enum": [
            "dungeness_commercial",
            "dungeness_recreational",
            "rock_crab",
            "salmon_commercial",
            "groundfish",
            "anchovy_sardine",
            "market_squid",
            "bivalve_shellfish",
            "spiny_lobster",
            "other"
          ],
          "title": "Fishery",
          "type": "string"
        },
        "headline": {
          "maxLength": 110,
          "title": "Headline",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "level": {
          "enum": [
            "closed",
            "delayed",
            "restricted",
            "watch",
            "no_restriction_on_record"
          ],
          "title": "Level",
          "type": "string"
        },
        "next_review": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Review"
        },
        "other_sources": {
          "items": {
            "type": "string"
          },
          "title": "Other Sources",
          "type": "array"
        },
        "review_state": {
          "enum": [
            "pending_human_review",
            "human_verified"
          ],
          "title": "Review State",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Until"
        }
      },
      "required": [
        "id",
        "fishery",
        "label",
        "level",
        "cause",
        "headline",
        "detail",
        "area_label",
        "applies_to_places",
        "effective",
        "until",
        "next_review",
        "source_name",
        "source_url",
        "checked_at",
        "review_state"
      ],
      "title": "FisheryStatus",
      "type": "object"
    },
    "RampState": {
