  "$id": "https://coastwatch/schemas/v1/fisheries-status.schema.json",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "ramp": {
      "anyOf": [
        {
          "$ref": "#/$defs/RampState"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "items": {
        "$ref": "#/$defs/FisheryStatus"
      },
      "title": "Records",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
