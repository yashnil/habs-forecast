{
  "$defs": {
    "AgeBin": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "title": "Age Days",
          "type": "integer"
        },
        "fraction": {
          "description": "Share of observed pixels with this age",
          "maximum": 1,
          "minimum": 0,
          "title": "Fraction",
          "type": "number"
        }
      },
      "required": [
        "age_days",
        "fraction"
      ],
      "title": "AgeBin",
      "type": "object"
    },
    "CompositeDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "UTC calendar date of the overpass(es)",
          "title": "Date",
          "type": "string"
        },
        "observed_times": {
          "description": "Upstream overpass time stamps, verbatim",
          "items": {
            "type": "string"
          },
          "title": "Observed Times",
          "type": "array"
        },
        "pixels_used": {
          "title": "Pixels Used",
          "type": "integer"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        }
      },
      "required": [
        "date",
        "platforms",
        "observed_times",
        "pixels_used"
      ],
      "title": "CompositeDay",
      "type": "object"
    },
    "CompositeInfo": {
      "additionalProperties": false,
      "description": "'Latest clear view': each pixel is its most recent valid observation within the\nwindow. Values are never interpolated or gap-filled; every pixel keeps its own date.",
      "properties": {
        "age_grid": {
          "$ref": "#/$defs/ValueGrid",
          "description": "Age in whole days at each cell (raw code = days)"
        },
        "age_histogram": {
          "items": {
            "$ref": "#/$defs/AgeBin"
          },
          "title": "Age Histogram",
          "type": "array"
        },
        "age_tiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/TileLayer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "days": {
          "items": {
            "$ref": "#/$defs/CompositeDay"
          },
          "title": "Composite Days",
          "type": "array"
        },
        "newest_observed_date": {
          "title": "Newest Observed Date",
          "type": "string"
        },
        "oldest_observed_date": {
          "title": "Oldest Observed Date",
          "type": "string"
        },
        "reference_date": {
          "description": "Date ages are counted from (UTC)",
          "title": "Reference Date",
          "type": "string"
        },
        "window_days": {
          "title": "Window Days",
          "type": "integer"
        }
      },
      "required": [
        "window_days",
        "reference_date",
        "newest_observed_date",
        "oldest_observed_date",
        "days",
        "age_histogram",
        "age_grid"
      ],
      "title": "CompositeInfo",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "How much of the ocean a layer actually observed. Satellite layers only.",
      "properties": {
        "domain_observed_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Domain Observed Fraction",
          "type": "number"
        },
        "domain_reference_cells": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Reference Cells"
        },
        "reference": {
          "description": "What the fractions are a share of",
          "title": "Reference",
          "type": "string"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionCoverage"
          },
          "title": "Coverage Regions",
          "type": "array"
        }
      },
      "required": [
        "reference",
        "domain_observed_fraction",
        "regions"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "ForecastRun": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "issued_date": {
          "title": "Issued Date",
          "type": "string"
        },
        "issued_date_derived": {
          "title": "Issued Date Derived",
          "type": "boolean"
        },
        "leads_available": {
          "items": {
            "type": "integer"
          },
          "title": "Leads Available",
          "type": "array"
        },
        "leads_missing": {
          "items": {
            "type": "integer"
          },
          "title": "Leads Missing",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "source_id",
        "issued_date",
        "issued_date_derived",
        "leads_available",
        "leads_missing",
        "notes"
      ],
      "title": "ForecastRun",
      "type": "object"
    },
    "FreshnessPolicy": {
      "additionalProperties": false,
      "description": "How the client classifies age. Computed in the browser so a dead pipeline\nstill degrades to 'stale' / 'historical' instead of looking current.",
      "properties": {
        "basis": {
          "enum": [
            "issued_date",
            "valid_date",
            "observed_date",
            "reviewed_date"
          ],
          "title": "Basis",
          "type": "string"
        },
        "current_max_age_days": {
          "minimum": 0,
          "title": "Current Max Age Days",
          "type": "integer"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "stale_max_age_days": {
          "description": "Older than this is 'historical'",
          "minimum": 0,
          "title": "Stale Max Age Days",
          "type": "integer"
        }
      },
      "required": [
        "basis",
        "current_max_age_days",
        "stale_max_age_days",
        "note"
      ],
      "title": "FreshnessPolicy",
      "type": "object"
    },
    "GridChunks": {
      "additionalProperties": false,
      "description": "A large grid split into row-major chunks so a browser fetches only the chunk it\nreads. Chunk (r, c) covers rows r*rows .. and columns c*cols .. of the full grid;\nedge chunks are smaller. Chunks with no value anywhere are not written.",
      "properties": {
        "cols": {
          "description": "Grid columns per chunk",
          "exclusiveMinimum": 0,
          "title": "Cols",
          "type": "integer"
        },
        "present": {
          "description": "'row_col' keys of the chunks that exist",
          "items": {
            "type": "string"
          },
          "title": "Present",
          "type": "array"
        },
        "rows": {
          "description": "Grid rows per chunk",
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "url_template": {
          "description": "Relative URL with {row} and {col}",
          "title": "Url Template",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "cols",
        "url_template",
        "present"
      ],
      "title": "GridChunks",
      "type": "object"
    },
    "LayerArtifact": {
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "composite": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessPolicy"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueGrid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "multisensor": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultiSensorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_resolution_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Approximate size of one source cell",
          "title": "Native Resolution M"
        },
        "palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/Palette"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "platforms": {
          "description": "Satellites or systems the values come from",
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "product_class": {
          "enum": [
            "official_regulatory",
            "official_forecast",
            "observation",
            "experimental_model",
            "historical_context",
            "reference",
            "derived_summary"
          ],
          "title": "Product Class",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "qc": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolution_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Deg"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "short_title": {
          "title": "Short Title",
          "type": "string"
        },
        "threshold_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Text"
        },
        "tiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/TileLayer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time": {
          "$ref": "#/$defs/TimeInfo"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "units": {
          "title": "Units",
          "type": "string"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "vectors": {
          "anyOf": [
            {
              "$ref": "#/$defs/VectorField"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "layer_id",
        "group_id",
        "product_class",
        "title",
        "short_title",
        "variable",
        "units",
        "description",
        "time",
        "freshness",
        "caveats",
        "provenance"
      ],
      "title": "LayerArtifact",
      "type": "object"
    },
    "MultiSensorInfo": {
      "additionalProperties": false,
      "description": "A display that shows, at each pixel, one sensor's own published observation. No values\nare averaged, blended or resampled; each member keeps its native grid, values and dates.",
      "properties": {
        "age_tiles": {
          "$ref": "#/$defs/TileLayer",
          "description": "Age in days of the observation shown at each pixel"
        },
        "agreement": {
          "items": {
            "$ref": "#/$defs/SensorAgreement"
          },
          "title": "Sensor Agreement",
          "type": "array"
        },
        "agreement_method": {
          "title": "Agreement Method",
          "type": "string"
        },
        "coverage_comparison": {
          "items": {
            "$ref": "#/$defs/SensorCoverage"
          },
          "title": "Coverage Comparison",
          "type": "array"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SensorMember"
          },
          "title": "Members",
          "type": "array"
        },
        "prefer_primary_within_days": {
          "description": "Primary wins unless the secondary observation is newer by more than this many days",
          "title": "Prefer Primary Within Days",
          "type": "integer"
        },
        "reference_date": {
          "title": "Reference Date",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "sensor_tiles": {
          "$ref": "#/$defs/TileLayer",
          "description": "Which sensor is shown at each pixel (categorical)"
        },
        "shown": {
          "items": {
            "$ref": "#/$defs/SensorShown"
          },
          "title": "Sensor Shown",
          "type": "array"
        }
      },
      "required": [
        "reference_date",
        "rule",
        "prefer_primary_within_days",
        "members",
        "sensor_tiles",
        "age_tiles",
        "coverage_comparison",
        "agreement_method",
        "agreement"
      ],
      "title": "MultiSensorInfo",
      "type": "object"
    },
    "Palette": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Domain",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "interpolation": {
          "default": "linear",
          "enum": [
            "linear",
            "step"
          ],
          "title": "Interpolation",
          "type": "string"
        },
        "nodata": {
          "const": "transparent",
          "default": "transparent",
          "title": "Nodata",
          "type": "string"
        },
        "scale": {
          "default": "linear",
          "enum": [
            "linear",
            "log10"
          ],
          "title": "Scale",
          "type": "string"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/PaletteStop"
          },
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "id",
        "domain",
        "stops"
      ],
      "title": "Palette",
      "type": "object"
    },
    "PaletteStop": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "color"
      ],
      "title": "PaletteStop",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "institution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "product_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version"
        },
        "request_urls": {
          "items": {
            "type": "string"
          },
          "title": "Request Urls",
          "type": "array"
        },
        "retrieved_at": {
          "description": "UTC ISO-8601 time the pipeline fetched the data",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_id": {
          "description": "Stable id of the upstream source, e.g. 'charm'",
          "title": "Source Id",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "description": "Dataset or page URL a person can open",
          "title": "Source Url",
          "type": "string"
        },
        "upstream_metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Selected upstream attributes kept verbatim",
          "title": "Upstream Metadata",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "source_name",
        "source_url",
        "license",
        "retrieved_at",
        "pipeline_version",
        "pipeline_run_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QCCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "QCCheck",
      "type": "object"
    },
    "QualityControl": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QCCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "n_cells": {
          "title": "N Cells",
          "type": "integer"
        },
        "n_valid": {
          "title": "N Valid",
          "type": "integer"
        },
        "valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Fraction",
          "type": "number"
        },
        "value_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Max"
        },
        "value_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Min"
        }
      },
      "required": [
        "checks",
        "n_cells",
        "n_valid",
        "valid_fraction",
        "value_min",
        "value_max"
      ],
      "title": "QualityControl",
      "type": "object"
    },
    "RasterImage": {
      "additionalProperties": false,
      "description": "A PNG already reprojected to EPSG:3857 so it can be placed by its corners.",
      "properties": {
        "bounds_lnglat": {
          "description": "west, south, east, north of the image edges",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bounds Lnglat",
          "type": "array"
        },
        "corners_lnglat": {
          "description": "[lng, lat] of top-left, top-right, bottom-right, bottom-left (MapLibre order)",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Corners Lnglat",
          "type": "array"
        },
        "crs": {
          "const": "EPSG:3857",
          "default": "EPSG:3857",
          "title": "Crs",
          "type": "string"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "resampling": {
          "const": "nearest",
          "default": "nearest",
          "title": "Resampling",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "bounds_lnglat",
        "corners_lnglat"
      ],
      "title": "RasterImage",
      "type": "object"
    },
    "RegionCoverage": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "observed_fraction": {
          "description": "Share of reference ocean cells with at least one value",
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Fraction",
          "type": "number"
        },
        "observed_km2": {
          "minimum": 0,
          "title": "Observed Km2",
          "type": "number"
        },
        "reference_cells": {
          "title": "Reference Cells",
          "type": "integer"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "label",
        "observed_fraction",
        "observed_km2",
        "reference_cells"
      ],
      "title": "RegionCoverage",
      "type": "object"
    },
    "SensorAgreement": {
      "additionalProperties": false,
      "description": "Same-day agreement between the two sensors where both observed a cell.",
      "properties": {
        "dates": {
          "items": {
            "type": "string"
          },
          "title": "Agreement Dates",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "median_log10_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median of log10(primary / secondary); 0.1 = primary 26% higher",
          "title": "Median Log10 Ratio"
        },
        "n_cells": {
          "title": "N Cells",
          "type": "integer"
        },
        "pearson_r_log10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pearson R Log10"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "rmsd_log10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmsd Log10"
        }
      },
      "required": [
        "region_id",
        "label",
        "n_cells",
        "dates"
      ],
      "title": "SensorAgreement",
