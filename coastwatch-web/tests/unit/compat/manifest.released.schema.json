        "v_grid": {
          "$ref": "#/$defs/ValueGrid",
          "description": "Northward velocity, m s-1"
        }
      },
      "required": [
        "u_grid",
        "v_grid",
        "depth_m",
        "speed_max"
      ],
      "title": "VectorField",
      "type": "object"
    }
