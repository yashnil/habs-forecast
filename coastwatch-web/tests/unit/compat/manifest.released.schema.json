    "ValueGrid": {
      "additionalProperties": false,
      "description": "Source values on the source (equirectangular) grid, quantized to uint16 and\ngzip-compressed. q = raw * scale_factor + add_offset; raw == nodata -> no value.\nvalue = q, or 10**q when transform is 'log10'. When `chunks` is set, `url` repeats\nthe chunk URL template and the grid must be read chunk by chunk.",
      "properties": {
        "add_offset": {
          "title": "Add Offset",
          "type": "number"
        },
        "chunks": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridChunks"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "encoding": {
          "const": "uint16le+gzip",
          "default": "uint16le+gzip",
          "title": "Encoding",
          "type": "string"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "lat_first": {
          "description": "Latitude of the first row's cell centre",
          "title": "Lat First",
          "type": "number"
        },
        "lat_step": {
          "description": "Signed step between rows",
          "title": "Lat Step",
          "type": "number"
        },
        "lon_first": {
          "title": "Lon First",
          "type": "number"
        },
        "lon_step": {
          "title": "Lon Step",
          "type": "number"
        },
        "max_quantization_error": {
          "description": "In the quantized (q) space",
          "title": "Max Quantization Error",
          "type": "number"
        },
        "nodata": {
          "default": 65535,
          "title": "Nodata",
          "type": "integer"
        },
        "scale_factor": {
          "title": "Scale Factor",
          "type": "number"
        },
        "transform": {
          "default": "none",
          "enum": [
            "none",
            "log10"
          ],
          "title": "Transform",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "lat_first",
        "lat_step",
        "lon_first",
        "lon_step",
        "scale_factor",
        "add_offset",
        "max_quantization_error"
      ],
      "title": "ValueGrid",
      "type": "object"
    },
    "VectorField": {
      "additionalProperties": false,
      "description": "Contract for ocean-current layers (WCOFS forecast, HF-radar observation).\nDefined ahead of the currents phase; no layer uses it yet.",
      "properties": {
